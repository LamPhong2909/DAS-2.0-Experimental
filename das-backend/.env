# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173     # Frontend URL

# Service Ports (cho development)
EAPP_PORT=3001
DAM_PORT=3002 
TAID_PORT=3003

# RabbitMQ Queues
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_DAM=dam_queue
RABBITMQ_QUEUE_EAPP=eapp_queue       # Thêm queue cho EAPP
RABBITMQ_QUEUE_TAID=taid_queue       # Thêm queue cho TAID

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/das?schema=public"

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_RAW=raw-media          # Default bucket cho raw files
MINIO_BUCKET_PROCESSED=processed-media  # Default bucket cho processed files