# API Gateway
API_GATEWAY_PORT=3000

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_DAM=dam_queue

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/das?schema=public"

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false