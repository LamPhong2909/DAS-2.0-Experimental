{
  "name": "das-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend monorepo for the Data Augmentation & Synthesis (DAS) system v2.0.",
  "scripts": {
    "build": "pnpm -r build",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "start:dev": "pnpm --parallel --stream -r start:dev",
    "lint": "eslint \"{apps,packages}/**/*.ts\" --fix",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:cov": "pnpm -r test:cov",
    "test:e2e": "pnpm -r test:e2e",
    "prepare": "husky install",
    "prisma:generate": "pnpm --filter @das/prisma-client exec prisma generate",
    "prisma:migrate": "pnpm --filter @das/prisma-client exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @das/prisma-client exec prisma studio"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
